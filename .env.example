# 키움증권 API
KIWOOM_APP_KEY=your_app_key_here
KIWOOM_APP_SECRET=your_app_secret_here
KIWOOM_API_BASE_URL=https://api.kiwoom.com

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000

# Grid Trader Cron
# true로 설정 시 자동으로 장시간(평일 09:00~15:30)만 가격 동기화 실행
# 잔고 동기화는 장시간과 무관하게 항상 실행
ENABLE_CRON=false

# Supabase Self-Hosting
NEXT_PUBLIC_SUPABASE_URL=https://supa.devhong.cc
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # Admin access for Cron jobs (RLS bypass)

# Supabase SaaS (타입 생성 전용 - pnpm db:types 실행 시 필요)
SUPABASE_PROJECT_ID=your_saas_project_id_here


# 폴링 로그 표시 여부
SHOW_POLLING_LOGS=true